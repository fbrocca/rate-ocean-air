# Copy to .env (gitignored) for local runs, or set these as GitHub Actions
# repository secrets for the daily workflow.

# --- Data source ---
# Get a key (free trial tier) at https://www.marketcheck.com/apis
MARKETCHECK_API_KEY=

# --- Email (SMTP) ---
# Example for Gmail: create an App Password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=you@gmail.com
# Optional: overrides notify.email_to in config.yaml
EMAIL_TO=fabio@inperaco.com
